{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technical-paper-ai-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  // Static frontend export; /api/* has no matching file so those requests
  // fall through to the Worker.
  "assets": {
    "directory": "../frontend/out",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "technical-paper-search"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "technical-paper-search-quota",
      "database_id": "e048dcc3-ca2c-40ee-9f11-657130b2b34a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "",
    "DEMO_ENABLED": "true",
    "DAILY_DEMO_LIMIT": "200"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
