{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technical-paper-ai-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "technical-paper-search"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "technical-paper-search-quota",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
